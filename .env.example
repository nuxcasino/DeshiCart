# DeshiCart — environment variables
# Copy this file to `.env` and fill in real values:
#   cp .env.example .env
#
# Never commit `.env` (it is git-ignored). Never paste real
# credentials into docs, issues, or chat.

# REQUIRED — PostgreSQL connection string.
# Used by the app (src/db/index.ts) and by drizzle-kit (drizzle.config.ts).
# Production (Vercel): use your Neon pooled connection string and set it in
# the Vercel dashboard (Project → Settings → Environment Variables) for
# Production, Preview, and Development as needed.
# Example (placeholder — not a real credential):
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-xxxx-pooler.c-5.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# OPTIONAL — standard Node environment flag.
# Vercel sets this automatically; set locally only if you need to force it.
# NODE_ENV="development"

# Online payments via SSLCommerz (bKash, Nagad, cards, netbanking).
# Required only if you offer the "Online Payment" checkout method.
# Sandbox values below are SSLCommerz's PUBLIC demo credentials — safe to
# commit. For production, replace with your store credentials from
# https://securepay.sslcommerz.com and set SSLCZ_SANDBOX="false".
SSLCZ_STORE_ID="testbox"
SSLCZ_STORE_PASSWORD="qwerty"
SSLCZ_SANDBOX="true"

# OPTIONAL — absolute site URL used for SSLCommerz success/fail/cancel/IPN
# callbacks. If unset, the app falls back to the incoming request's host
# (works on Vercel automatically). Set it when using a custom domain to make
# callbacks deterministic.
# SITE_URL="https://deshi-cart.vercel.app"

# OPTIONAL — order notifications (SMS + email). When unset, notifications are
# skipped with a console log — order placement still works fine.
# SMS via SSL Wireless (https://smsplus.sslwireless.com):
# SSLW_API_TOKEN="your-api-token"
# SSLW_SID="your-sender-sid"
# Email via any SMTP provider (Gmail app password, SendGrid, etc.):
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="you@email.com"
# SMTP_PASS="your-app-password"
# SMTP_FROM="DeshiCart <hello@deshicart.com.bd>"
# Contact form + notification inbox (defaults to SMTP_FROM):
# SHOP_EMAIL="hello@deshicart.com.bd"

# REQUIRED to save payment gateway credentials via /admin/payment-gateways.
# 32 random bytes as 64 hex chars. Generate with: openssl rand -hex 32
# Never commit the real value. Without it, gateways run on SSLCZ_* env
# fallback (sandbox) and credential saves are refused.
# PAYMENT_CREDENTIALS_KEY="..."
